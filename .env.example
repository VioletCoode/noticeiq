# ==========================================================
# Frontend Client Environment Variables (Safe for Vercel)
# ==========================================================
# Supabase Public Configuration (Public Anon Key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OneSignal Web Push App ID (Public Client ID)
VITE_ONESIGNAL_APP_ID=your_onesignal_app_id_here

# ==========================================================
# Server-Side Secrets (DO NOT put in Vercel or frontend .env)
# Set these in Supabase Edge Functions via CLI:
#   npx supabase secrets set GEMINI_API_KEY=your_key
#   npx supabase secrets set GROQ_API_KEY=your_key
# ==========================================================